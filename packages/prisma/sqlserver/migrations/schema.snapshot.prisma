model Booking {
  id                     Int                        @id @default(autoincrement())
  uid                    String                     @unique
  // (optional) UID based on slot start/end time & email against duplicates
  idempotencyKey         String?                    @unique
  user                   User?                      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId                 Int?
  // User's email at the time of booking
  /// @zod.import(["import { emailSchema } from '../../zod-utils'"]).custom.use(emailSchema)
  userPrimaryEmail       String? @db.NVarChar(Max)
  references             BookingReference[]
  eventType              EventType?                 @relation(fields: [eventTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  eventTypeId            Int?
  title                  String @db.NVarChar(Max)
  description            String? @db.NVarChar(Max)
  customInputs           String? @db.NVarChar(Max)
  /// @zod.import(["import { bookingResponses } from '../../zod-utils'"]).custom.use(bookingResponses)
  responses              String? @db.NVarChar(Max)
  startTime              DateTime
  endTime                DateTime
  attendees              Attendee[]
  location               String? @db.NVarChar(Max)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime?                  @updatedAt
  status                 String @db.NVarChar(100)              @default("ACCEPTED")
  paid                   Boolean                    @default(false)
  payment                Payment[]
  destinationCalendar    DestinationCalendar?       @relation(fields: [destinationCalendarId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destinationCalendarId  Int?
  cancellationReason     String? @db.NVarChar(Max)
  rejectionReason        String? @db.NVarChar(Max)
  reassignReason         String? @db.NVarChar(Max)
  reassignBy             User?                      @relation("reassignByUser", fields: [reassignById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reassignById           Int?
  dynamicEventSlugRef    String? @db.NVarChar(Max)
  dynamicGroupSlugRef    String? @db.NVarChar(Max)
  rescheduled            Boolean?
  fromReschedule         String?
  recurringEventId       String?
  smsReminderNumber      String? @db.NVarChar(Max)
  scheduledJobs          String @db.NVarChar(Max) @default("[]") // scheduledJobs is deprecated, please use scheduledTriggers instead
  seatsReferences        BookingSeat[]
  /// @zod.import(["import { bookingMetadataSchema } from '../../zod-utils'"]).custom.use(bookingMetadataSchema)
  metadata               String? @db.NVarChar(Max)
  isRecorded             Boolean                    @default(false)
  iCalUID                String? @db.NVarChar(Max)                    @default("")
  iCalSequence           Int                        @default(0)
  instantMeetingToken    InstantMeetingToken?
  rating                 Int?
  ratingFeedback         String? @db.NVarChar(Max)
  noShowHost             Boolean?                   @default(false)
  scheduledTriggers      WebhookScheduledTriggers[]
  oneTimePassword        String?                    @unique @default(uuid())
  /// @zod.import(["import { emailSchema } from '../../zod-utils'"]).custom.use(emailSchema)
  cancelledBy            String? @db.NVarChar(Max)
  /// @zod.import(["import { emailSchema } from '../../zod-utils'"]).custom.use(emailSchema)
  rescheduledBy          String? @db.NVarChar(Max)
  assignmentReason       AssignmentReason[]
  internalNote           BookingInternalNote[]
  creationSource         String? @db.NVarChar(100)
  tracking               Tracking?
  expenseLogs            CreditExpenseLog[]
  report                 BookingReport?
  wrongAssignmentReports WrongAssignmentReport[]

  // @@partial_index([reassignById])

  @@index([eventTypeId])
  @@index([userId])
  @@index([destinationCalendarId])
  @@index([recurringEventId])
  @@index([uid])
  @@index([status])
  @@index([startTime, endTime, status])
  @@index([fromReschedule])
  @@index([userId, endTime])
  @@index([userId, status, startTime])
  @@index([eventTypeId, status])
  @@index([userId, createdAt])
}

model Tracking {
