  updatedAt       DateTime                    @updatedAt

  @@index([reportedById])
  @@index([teamId])
  @@index([status])
  @@index([reviewedById])
  @@index([createdAt])
  @@index([teamId, status, createdAt])
}



model OrganizationOnboarding {
  // TODO: Use uuid for id
  id String @id @default(uuid())

  // User who started the onboarding. It is different from orgOwnerEmail in case Cal.diy admin is doing the onboarding for someone else.
  createdBy   User     @relation("CreatedOrganizationOnboardings", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdById Int
  createdAt   DateTime @default(now())

  // We keep the email only here and don't need to connect it with user because on User deletion, we don't delete the entry here.
  // It is unique because an email can be the owner of only one organization at a time.
  orgOwnerEmail String  @unique
  error         String? @db.NVarChar(Max)

  updatedAt DateTime @updatedAt
  // TODO: updatedBy to be added when we support marking updatedBy using webhook too, as webhook also updates it

  // Set after organization payment is done and the organization is created
  organizationId Int?  @unique
  organization   Team? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  billingPeriod String @db.NVarChar(100)
  pricePerSeat  Float
  seats         Int

  isPlatform Boolean @default(false)

  // Organization info
  name               String @db.NVarChar(Max)
  // We don't keep it unique because we don't want self-serve flows to block a slug if it isn't paid for yet.
  slug               String @db.NVarChar(Max)
  logo               String? @db.NVarChar(Max)
  bio                String? @db.NVarChar(Max)
  brandColor         String? @db.NVarChar(Max)
  bannerUrl          String? @db.NVarChar(Max)
  isDomainConfigured Boolean @default(false)

  // Set when payment intent is there.
  stripeCustomerId         String? @unique
  // TODO: Can we make it required
  stripeSubscriptionId     String? @db.NVarChar(Max)
  stripeSubscriptionItemId String? @db.NVarChar(Max)

  /// @zod.import(["import { orgOnboardingInvitedMembersSchema } from '../../zod-utils'"]).custom.use(orgOnboardingInvitedMembersSchema)
  invitedMembers String @db.NVarChar(Max) @default("[]")

  /// @zod.import(["import { orgOnboardingTeamsSchema } from '../../zod-utils'"]).custom.use(orgOnboardingTeamsSchema)
  teams String @db.NVarChar(Max) @default("[]")

  // Completion status
  isComplete Boolean @default(false)

  @@index([orgOwnerEmail])
  @@index([stripeCustomerId])
}

