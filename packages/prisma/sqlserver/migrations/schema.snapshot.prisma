  rrTimestampBasis       String @db.NVarChar(100)        @default("CREATED_AT")
  brandColor             String? @db.NVarChar(Max)
  darkBrandColor         String? @db.NVarChar(Max)
  verifiedNumbers        VerifiedNumber[]
  verifiedEmails         VerifiedEmail[]
  bannerUrl              String? @db.NVarChar(Max)
  parentId               Int?
  parent                 Team?                   @relation("organization", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
