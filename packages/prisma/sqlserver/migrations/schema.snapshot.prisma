  booking         Booking                     @relation(fields: [bookingUid], references: [uid], onDelete: Cascade, onUpdate: NoAction)
  reportedById    Int?
  reportedBy      User?                       @relation("WrongAssignmentReportedBy", fields: [reportedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  correctAssignee String? @db.NVarChar(Max)
  additionalNotes String @db.NVarChar(Max)
  teamId          Int?
  team            Team?                       @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  status          String @db.NVarChar(100) @default("PENDING")
  reviewedById    Int?
  reviewedBy      User?                       @relation("WrongAssignmentReviewedBy", fields: [reviewedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewedAt      DateTime?
