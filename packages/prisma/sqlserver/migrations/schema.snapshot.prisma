model FilterSegment {
  id               Int                           @id @default(autoincrement())
  name             String @db.NVarChar(Max)
  // Identifies which data table this segment belongs to (e.g. "organization_members", "team_members", "bookings", etc.)
  tableIdentifier  String
  scope            String @db.NVarChar(100)
  // Filter configuration
  activeFilters    String? @db.NVarChar(Max)
  sorting          String? @db.NVarChar(Max)
  columnVisibility String? @db.NVarChar(Max)
  columnSizing     String? @db.NVarChar(Max)
  perPage          Int
  searchTerm       String?                       @db.NVarChar(Max)
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  // Creator of the segment
  user             User                          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userId           Int
  // Team scope - optional, only set when scope is TEAM
  team             Team?                         @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teamId           Int?
  userPreferences  UserFilterSegmentPreference[]

  // For user-scoped segments: scope + userId + tableIdentifier
  @@index([scope, userId, tableIdentifier])
  // For team-scoped segments: scope + teamId + tableIdentifier
  @@index([scope, teamId, tableIdentifier])
}

model UserFilterSegmentPreference {
  id              Int            @id @default(autoincrement())
  userId          Int
  tableIdentifier String
  segmentId       Int?
  systemSegmentId String? @db.NVarChar(Max)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  segment         FilterSegment? @relation(fields: [segmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, tableIdentifier])
  @@index([userId])
  @@index([segmentId])
}

